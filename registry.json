{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "swagui",
  "homepage": "https://swagui.rohoswagger.com",
  "items": [
    {
      "name": "theme",
      "type": "registry:style",
      "title": "swagui theme",
      "description": "Design tokens: type, radius, brand colour, canvas, surface, density and motion. Every value is a knob; there are no presets.",
      "dependencies": [
        "tw-animate-css"
      ],
      "cssVars": {
        "theme": {
          "color-background": "var(--background)",
          "color-foreground": "var(--foreground)",
          "color-card": "var(--card)",
          "color-card-foreground": "var(--card-foreground)",
          "color-popover": "var(--popover)",
          "color-popover-foreground": "var(--popover-foreground)",
          "color-primary": "var(--primary)",
          "color-primary-foreground": "var(--primary-foreground)",
          "color-secondary": "var(--secondary)",
          "color-secondary-foreground": "var(--secondary-foreground)",
          "color-muted": "var(--muted)",
          "color-muted-foreground": "var(--muted-foreground)",
          "color-accent": "var(--accent)",
          "color-accent-foreground": "var(--accent-foreground)",
          "color-destructive": "var(--destructive)",
          "color-border": "var(--border)",
          "color-input": "var(--input)",
          "color-ring": "var(--ring)",
          "color-brand": "var(--brand)",
          "color-brand-content": "var(--brand-content)",
          "color-chart-1": "var(--chart-1)",
          "color-chart-2": "var(--chart-2)",
          "color-chart-3": "var(--chart-3)",
          "color-chart-4": "var(--chart-4)",
          "color-chart-5": "var(--chart-5)",
          "font-sans": "var(--font-body)",
          "font-mono": "var(--font-mono-face)",
          "radius-sm": "calc(0.375rem * var(--squircle-factor))",
          "radius-md": "calc(0.5rem * var(--squircle-factor))",
          "radius-lg": "calc(0.75rem * var(--squircle-factor))",
          "radius-xl": "calc(1rem * var(--squircle-factor))",
          "radius-2xl": "calc(1.5rem * var(--squircle-factor))",
          "ease-swagui": "cubic-bezier(0.22, 1, 0.36, 1)",
          "ease-out-expo": "cubic-bezier(0.16, 1, 0.3, 1)",
          "duration-press": "120ms",
          "duration-fast": "180ms",
          "duration-base": "260ms",
          "duration-slow": "420ms"
        },
        "light": {
          "font-display": "var(--font-body)",
          "font-body": "ui-sans-serif, system-ui, sans-serif",
          "font-mono-face": "ui-monospace, SFMono-Regular, monospace",
          "display-tracking": "-0.03em",
          "squircle-factor": "1.4",
          "radius": "calc(0.625rem * var(--squircle-factor))",
          "brand": "oklch(0.58 0.16 250)",
          "brand-content": "oklch(0.5 0.16 250)",
          "background": "oklch(0.991 0 0)",
          "foreground": "oklch(0.18 0 0)",
          "card": "oklch(0.999 0 0)",
          "muted-foreground": "oklch(0.498 0 0)",
          "card-foreground": "var(--foreground)",
          "popover": "var(--card)",
          "popover-foreground": "var(--foreground)",
          "primary": "var(--foreground)",
          "primary-foreground": "var(--background)",
          "secondary": "color-mix(in oklch, var(--foreground) 6%, transparent)",
          "secondary-foreground": "var(--foreground)",
          "muted": "color-mix(in oklch, var(--foreground) 5%, transparent)",
          "accent": "color-mix(in oklch, var(--foreground) 6%, transparent)",
          "accent-foreground": "var(--foreground)",
          "border": "color-mix(in oklch, var(--foreground) 8%, transparent)",
          "input": "color-mix(in oklch, var(--foreground) 10%, transparent)",
          "ring": "color-mix(in oklch, var(--brand) 55%, transparent)",
          "destructive": "oklch(0.55 0.2 27)",
          "success": "oklch(0.55 0.13 155)",
          "warning": "oklch(0.68 0.14 75)",
          "chart-1": "oklch(0.646 0.222 41.116)",
          "chart-2": "oklch(0.6 0.118 184.704)",
          "chart-3": "oklch(0.398 0.07 227.392)",
          "chart-4": "oklch(0.828 0.189 84.429)",
          "chart-5": "oklch(0.769 0.188 70.08)"
        },
        "dark": {
          "background": "oklch(0.148 0 0)",
          "foreground": "oklch(0.958 0 0)",
          "card": "oklch(0.2 0 0)",
          "muted-foreground": "oklch(0.716 0 0)",
          "brand": "oklch(0.7 0.14 250)",
          "brand-content": "oklch(0.7 0.14 250)",
          "destructive": "oklch(0.68 0.18 25)",
          "success": "oklch(0.72 0.12 155)",
          "warning": "oklch(0.78 0.13 78)",
          "inset-highlight": "inset 0 1px 1px rgb(255 255 255 / 0.06)"
        }
      },
      "css": {
        "@import \"tw-animate-css\"": "",
        "@custom-variant dark (&:is(.dark *))": "",
        "[data-base=\"ash\"]": {
          "--background": "oklch(0.991 0 0)",
          "--card": "oklch(0.999 0 0)",
          "--foreground": "oklch(0.18 0 0)",
          "--muted-foreground": "oklch(0.498 0 0)"
        },
        "[data-base=\"slate\"]": {
          "--background": "oklch(0.991 0.007 255)",
          "--card": "oklch(0.999 0.003 255)",
          "--foreground": "oklch(0.18 0.020 255)",
          "--muted-foreground": "oklch(0.498 0.028 255)"
        },
        "[data-base=\"clay\"]": {
          "--background": "oklch(0.991 0.007 45)",
          "--card": "oklch(0.999 0.003 45)",
          "--foreground": "oklch(0.18 0.020 45)",
          "--muted-foreground": "oklch(0.498 0.028 45)"
        },
        "[data-base=\"sage\"]": {
          "--background": "oklch(0.991 0.007 150)",
          "--card": "oklch(0.999 0.003 150)",
          "--foreground": "oklch(0.18 0.020 150)",
          "--muted-foreground": "oklch(0.498 0.028 150)"
        },
        "[data-base=\"mauve\"]": {
          "--background": "oklch(0.991 0.007 315)",
          "--card": "oklch(0.999 0.003 315)",
          "--foreground": "oklch(0.18 0.020 315)",
          "--muted-foreground": "oklch(0.498 0.028 315)"
        },
        "[data-base=\"olive\"]": {
          "--background": "oklch(0.991 0.007 110)",
          "--card": "oklch(0.999 0.003 110)",
          "--foreground": "oklch(0.18 0.020 110)",
          "--muted-foreground": "oklch(0.498 0.028 110)"
        },
        ".dark[data-base=\"ash\"],\n.dark [data-base=\"ash\"]": {
          "--background": "oklch(0.148 0 0)",
          "--card": "oklch(0.2 0 0)",
          "--foreground": "oklch(0.958 0 0)",
          "--muted-foreground": "oklch(0.716 0 0)"
        },
        ".dark[data-base=\"slate\"],\n.dark [data-base=\"slate\"]": {
          "--background": "oklch(0.148 0.015 255)",
          "--card": "oklch(0.2 0.017 255)",
          "--foreground": "oklch(0.958 0.009 255)",
          "--muted-foreground": "oklch(0.716 0.024 255)"
        },
        ".dark[data-base=\"clay\"],\n.dark [data-base=\"clay\"]": {
          "--background": "oklch(0.148 0.015 45)",
          "--card": "oklch(0.2 0.017 45)",
          "--foreground": "oklch(0.958 0.009 45)",
          "--muted-foreground": "oklch(0.716 0.024 45)"
        },
        ".dark[data-base=\"sage\"],\n.dark [data-base=\"sage\"]": {
          "--background": "oklch(0.148 0.015 150)",
          "--card": "oklch(0.2 0.017 150)",
          "--foreground": "oklch(0.958 0.009 150)",
          "--muted-foreground": "oklch(0.716 0.024 150)"
        },
        ".dark[data-base=\"mauve\"],\n.dark [data-base=\"mauve\"]": {
          "--background": "oklch(0.148 0.015 315)",
          "--card": "oklch(0.2 0.017 315)",
          "--foreground": "oklch(0.958 0.009 315)",
          "--muted-foreground": "oklch(0.716 0.024 315)"
        },
        ".dark[data-base=\"olive\"],\n.dark [data-base=\"olive\"]": {
          "--background": "oklch(0.148 0.015 110)",
          "--card": "oklch(0.2 0.017 110)",
          "--foreground": "oklch(0.958 0.009 110)",
          "--muted-foreground": "oklch(0.716 0.024 110)"
        },
        ":root,\n[data-surface=\"elevation\"]": {
          "--shadow-hairline": "0 0 0 0.5px color-mix(in oklch, var(--foreground) 12%, transparent)",
          "--shadow-raised": "0 1px 2px rgb(0 0 0 / 0.035), 0 3px 8px rgb(0 0 0 / 0.035), 0 8px 28px rgb(0 0 0 / 0.045)",
          "--shadow-overlay": "0 1px 2px rgb(0 0 0 / 0.04), 0 4px 12px rgb(0 0 0 / 0.05), 0 16px 48px rgb(0 0 0 / 0.06)",
          "--inset-highlight": "inset 0 1px 1px rgb(255 255 255 / 0.8)"
        },
        "[data-surface=\"bevel\"]": {
          "--shadow-hairline": "0 0 0 0.5px color-mix(in oklch, var(--foreground) 18%, transparent)",
          "--shadow-raised": "0 0 0 0.5px color-mix(in oklch, var(--foreground) 18%, transparent),\n    0 4px 6px -1px rgb(0 0 0 / 0.05), 0 2px 4px -2px rgb(0 0 0 / 0.05)",
          "--shadow-overlay": "0 0 0 0.5px color-mix(in oklch, var(--foreground) 18%, transparent),\n    0 12px 32px -8px rgb(0 0 0 / 0.12)",
          "--inset-highlight": "inset 0 0 0 1px color-mix(in oklch, white 70%, transparent)"
        },
        "[data-surface=\"glass\"]": {
          "--shadow-hairline": "0 0 0 1px color-mix(in oklch, var(--foreground) 8%, transparent)",
          "--shadow-raised": "0 10px 30px -10px color-mix(in oklch, var(--foreground) 12%, transparent),\n    inset 0 1px 1px color-mix(in oklch, var(--foreground) 10%, transparent)",
          "--shadow-overlay": "0 16px 48px -12px color-mix(in oklch, var(--foreground) 18%, transparent),\n    inset 0 1px 1px color-mix(in oklch, var(--foreground) 12%, transparent)",
          "--inset-highlight": "inset 0 1px 1px color-mix(in oklch, var(--foreground) 10%, transparent)"
        },
        "[data-density=\"compact\"]": {
          "--spacing": "0.2rem",
          "--squircle-factor": "1.1",
          "--text-xs--line-height": "1.3",
          "--text-sm--line-height": "1.35",
          "--text-base--line-height": "1.4",
          "--text-lg--line-height": "1.35",
          "--text-xl--line-height": "1.3",
          "--text-2xl--line-height": "1.2"
        },
        "[data-density=\"comfortable\"]": {
          "--spacing": "0.25rem"
        },
        "@layer base": {
          "*": {
            "border-color": "var(--border)",
            "outline-color": "color-mix(in oklch, var(--ring) 50%, transparent)"
          },
          "body": {
            "background-color": "var(--background)",
            "color": "var(--foreground)",
            "font-family": "var(--font-body)",
            "-webkit-font-smoothing": "antialiased"
          },
          "svg.lucide": {
            "stroke-width": "1.5"
          },
          "h1,\n  h2,\n  h3,\n  h4,\n  h5,\n  h6": {
            "font-family": "var(--font-display)"
          },
          "h1,\n  h2,\n  h3": {
            "letter-spacing": "var(--display-tracking)"
          },
          "h4,\n  h5,\n  h6": {
            "letter-spacing": "calc(var(--display-tracking) * 0.66)"
          }
        },
        "@layer components": {
          ".brand-link": {
            "color": "var(--brand-content)",
            "text-decoration": "underline",
            "text-decoration-style": "dotted",
            "text-underline-offset": "3px",
            "text-decoration-color": "color-mix(in oklch, var(--brand) 40%, transparent)"
          },
          ".brand-dot": {
            "background": "var(--brand)",
            "box-shadow": "0 0 0 3px color-mix(in oklch, var(--brand) 15%, transparent)"
          },
          ".brand-glow": {
            "box-shadow": "0 0 36px 2px color-mix(in oklch, var(--brand) 8%, transparent),\n      0 8px 50px 6px color-mix(in oklch, var(--brand) 5%, transparent)"
          }
        }
      }
    },
