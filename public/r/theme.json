{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme",
  "type": "registry:style",
  "title": "swagui theme",
  "description": "Design tokens: type, radius, brand colour, canvas, surface, density and motion. Every value is a knob; there are no presets.",
  "dependencies": [
    "tw-animate-css"
  ],
  "cssVars": {
    "theme": {
      "color-background": "var(--background)",
      "color-foreground": "var(--foreground)",
      "color-card": "var(--card)",
      "color-card-foreground": "var(--card-foreground)",
      "color-popover": "var(--popover)",
      "color-popover-foreground": "var(--popover-foreground)",
      "color-primary": "var(--primary)",
      "color-primary-foreground": "var(--primary-foreground)",
      "color-secondary": "var(--secondary)",
      "color-secondary-foreground": "var(--secondary-foreground)",
      "color-muted": "var(--muted)",
      "color-muted-foreground": "var(--muted-foreground)",
      "color-accent": "var(--accent)",
      "color-accent-foreground": "var(--accent-foreground)",
      "color-destructive": "var(--destructive)",
      "color-destructive-foreground": "var(--destructive-foreground)",
      "color-success": "var(--success)",
      "color-success-foreground": "var(--success-foreground)",
      "color-warning": "var(--warning)",
      "color-warning-foreground": "var(--warning-foreground)",
      "color-border": "var(--border)",
      "color-input": "var(--input)",
      "color-ring": "var(--ring)",
      "color-brand": "var(--brand)",
      "color-brand-content": "var(--brand-content)",
      "color-sidebar": "var(--sidebar)",
      "color-sidebar-foreground": "var(--sidebar-foreground)",
      "color-sidebar-primary": "var(--sidebar-primary)",
      "color-sidebar-primary-foreground": "var(--sidebar-primary-foreground)",
      "color-sidebar-accent": "var(--sidebar-accent)",
      "color-sidebar-accent-foreground": "var(--sidebar-accent-foreground)",
      "color-sidebar-border": "var(--sidebar-border)",
      "color-sidebar-ring": "var(--sidebar-ring)",
      "color-chart-1": "var(--chart-1)",
      "color-chart-2": "var(--chart-2)",
      "color-chart-3": "var(--chart-3)",
      "color-chart-4": "var(--chart-4)",
      "color-chart-5": "var(--chart-5)",
      "font-sans": "var(--font-body)",
      "font-mono": "var(--font-mono-face)",
      "radius-sm": "calc(0.375rem * var(--squircle-factor))",
      "radius-md": "calc(0.5rem * var(--squircle-factor))",
      "radius-lg": "calc(0.75rem * var(--squircle-factor))",
      "radius-xl": "calc(1rem * var(--squircle-factor))",
      "radius-2xl": "calc(1.5rem * var(--squircle-factor))",
      "ease-swagui": "cubic-bezier(0.22, 1, 0.36, 1)",
      "ease-out-expo": "cubic-bezier(0.16, 1, 0.3, 1)",
      "ease-spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "ease-soft": "cubic-bezier(0.4, 0, 0.2, 1)",
      "duration-press": "120ms",
      "duration-fast": "180ms",
      "duration-base": "260ms",
      "duration-slow": "420ms",
      "animate-shimmer": "swagui-shimmer 1.8s linear infinite",
      "animate-snake": "swagui-snake 3.6s linear infinite",
      "animate-emerge": "swagui-emerge var(--duration-base) var(--ease-soft) both",
      "animate-reveal": "swagui-reveal var(--duration-base) var(--ease-soft)",
      "animate-conceal": "swagui-conceal var(--duration-fast) var(--ease-soft)"
    },
    "light": {
      "font-display": "var(--font-body)",
      "font-body": "ui-sans-serif, system-ui, sans-serif",
      "font-mono-face": "ui-monospace, SFMono-Regular, monospace",
      "display-tracking": "-0.03em",
      "squircle-factor": "1.4",
      "radius": "calc(0.625rem * var(--squircle-factor))",
      "brand": "oklch(0.58 0.16 250)",
      "brand-content": "oklch(0.5 0.16 250)",
      "background": "oklch(0.991 0 0)",
      "foreground": "oklch(0.18 0 0)",
      "card": "oklch(0.999 0 0)",
      "muted-foreground": "oklch(0.498 0 0)",
      "destructive": "oklch(0.55 0.2 27)",
      "success": "oklch(0.53 0.13 155)",
      "warning": "oklch(0.68 0.14 75)",
      "success-foreground": "oklch(1 0 0)",
      "warning-foreground": "oklch(0.16 0 0)",
      "chart-1": "oklch(0.646 0.222 41.116)",
      "chart-2": "oklch(0.6 0.118 184.704)",
      "chart-3": "oklch(0.398 0.07 227.392)",
      "chart-4": "oklch(0.828 0.189 84.429)",
      "chart-5": "oklch(0.769 0.188 70.08)"
    },
    "dark": {
      "background": "oklch(0.148 0 0)",
      "foreground": "oklch(0.958 0 0)",
      "card": "oklch(0.2 0 0)",
      "muted-foreground": "oklch(0.716 0 0)",
      "brand": "oklch(0.7 0.14 250)",
      "brand-content": "oklch(0.7 0.14 250)",
      "destructive": "oklch(0.68 0.18 25)",
      "success": "oklch(0.72 0.12 155)",
      "warning": "oklch(0.78 0.13 78)",
      "success-foreground": "oklch(0.16 0 0)",
      "warning-foreground": "oklch(0.16 0 0)",
      "inset-highlight": "inset 0 1px 0 0 rgb(255 255 255 / 0.07)"
    }
  },
  "css": {
    "@import \"tw-animate-css\"": "",
    "@custom-variant dark (&:is(.dark *))": "",
    "@keyframes swagui-shimmer": {
      "from": {
        "background-position": "200% center"
      },
      "to": {
        "background-position": "-200% center"
      }
    },
    "@property --snake-angle": {
      "syntax": "\"<angle>\"",
      "initial-value": "0deg",
      "inherits": "false"
    },
    "@keyframes swagui-snake": {
      "to": {
        "--snake-angle": "360deg"
      }
    },
    "@keyframes swagui-emerge": {
      "from": {
        "opacity": "0",
        "filter": "blur(5px)"
      },
      "to": {
        "opacity": "1",
        "filter": "blur(0)"
      }
    },
    "@keyframes swagui-reveal": {
      "from": {
        "height": "0",
        "opacity": "0"
      },
      "to": {
        "height": "var(--radix-collapsible-content-height)",
        "opacity": "1"
      }
    },
    "@keyframes swagui-conceal": {
      "from": {
        "height": "var(--radix-collapsible-content-height)",
        "opacity": "1"
      },
      "to": {
        "height": "0",
        "opacity": "0"
      }
    },
    "@keyframes swagui-wave": {
      "from": {
        "transform": "translateX(-60%)"
      },
      "to": {
        "transform": "translateX(60%)"
      }
    },
    ":root,\n.dark,\n[data-base]": {
      "--card-foreground": "var(--foreground)",
      "--popover": "var(--card)",
      "--popover-foreground": "var(--foreground)",
      "--primary": "var(--foreground)",
      "--primary-foreground": "var(--background)",
      "--secondary": "color-mix(in oklch, var(--foreground) 6%, transparent)",
      "--secondary-foreground": "var(--foreground)",
      "--muted": "color-mix(in oklch, var(--foreground) 5%, transparent)",
      "--accent": "color-mix(in oklch, var(--foreground) 6%, transparent)",
      "--accent-foreground": "var(--foreground)",
      "--border": "color-mix(in oklch, var(--foreground) 8%, transparent)",
      "--input": "color-mix(in oklch, var(--foreground) 10%, transparent)",
      "--ring": "color-mix(in oklch, var(--brand) 55%, transparent)",
      "--destructive-foreground": "oklch(1 0 0)",
      "--sidebar": "color-mix(in oklch, var(--foreground) 3%, var(--background))",
      "--sidebar-foreground": "var(--foreground)",
      "--sidebar-primary": "var(--foreground)",
      "--sidebar-primary-foreground": "var(--background)",
      "--sidebar-accent": "color-mix(in oklch, var(--foreground) 6%, transparent)",
      "--sidebar-accent-foreground": "var(--foreground)",
      "--sidebar-border": "color-mix(in oklch, var(--foreground) 8%, transparent)",
      "--sidebar-ring": "color-mix(in oklch, var(--brand) 55%, transparent)"
    },
    "[data-base=\"ash\"]": {
      "--background": "oklch(0.991 0 0)",
      "--card": "oklch(0.999 0 0)",
      "--foreground": "oklch(0.18 0 0)",
      "--muted-foreground": "oklch(0.498 0 0)"
    },
    "[data-base=\"slate\"]": {
      "--background": "oklch(0.991 0.007 255)",
      "--card": "oklch(0.999 0.003 255)",
      "--foreground": "oklch(0.18 0.020 255)",
      "--muted-foreground": "oklch(0.498 0.028 255)"
    },
    "[data-base=\"clay\"]": {
      "--background": "oklch(0.991 0.007 45)",
      "--card": "oklch(0.999 0.003 45)",
      "--foreground": "oklch(0.18 0.020 45)",
      "--muted-foreground": "oklch(0.498 0.028 45)"
    },
    "[data-base=\"sage\"]": {
      "--background": "oklch(0.991 0.007 150)",
      "--card": "oklch(0.999 0.003 150)",
      "--foreground": "oklch(0.18 0.020 150)",
      "--muted-foreground": "oklch(0.498 0.028 150)"
    },
    "[data-base=\"mauve\"]": {
      "--background": "oklch(0.991 0.007 315)",
      "--card": "oklch(0.999 0.003 315)",
      "--foreground": "oklch(0.18 0.020 315)",
      "--muted-foreground": "oklch(0.498 0.028 315)"
    },
    "[data-base=\"olive\"]": {
      "--background": "oklch(0.991 0.007 110)",
      "--card": "oklch(0.999 0.003 110)",
      "--foreground": "oklch(0.18 0.020 110)",
      "--muted-foreground": "oklch(0.498 0.028 110)"
    },
    ".dark[data-base=\"ash\"],\n.dark [data-base=\"ash\"]": {
      "--background": "oklch(0.148 0 0)",
      "--card": "oklch(0.2 0 0)",
      "--foreground": "oklch(0.958 0 0)",
      "--muted-foreground": "oklch(0.716 0 0)"
    },
    ".dark[data-base=\"slate\"],\n.dark [data-base=\"slate\"]": {
      "--background": "oklch(0.148 0.015 255)",
      "--card": "oklch(0.2 0.017 255)",
      "--foreground": "oklch(0.958 0.009 255)",
      "--muted-foreground": "oklch(0.716 0.024 255)"
    },
    ".dark[data-base=\"clay\"],\n.dark [data-base=\"clay\"]": {
      "--background": "oklch(0.148 0.015 45)",
      "--card": "oklch(0.2 0.017 45)",
      "--foreground": "oklch(0.958 0.009 45)",
      "--muted-foreground": "oklch(0.716 0.024 45)"
    },
    ".dark[data-base=\"sage\"],\n.dark [data-base=\"sage\"]": {
      "--background": "oklch(0.148 0.015 150)",
      "--card": "oklch(0.2 0.017 150)",
      "--foreground": "oklch(0.958 0.009 150)",
      "--muted-foreground": "oklch(0.716 0.024 150)"
    },
    ".dark[data-base=\"mauve\"],\n.dark [data-base=\"mauve\"]": {
      "--background": "oklch(0.148 0.015 315)",
      "--card": "oklch(0.2 0.017 315)",
      "--foreground": "oklch(0.958 0.009 315)",
      "--muted-foreground": "oklch(0.716 0.024 315)"
    },
    ".dark[data-base=\"olive\"],\n.dark [data-base=\"olive\"]": {
      "--background": "oklch(0.148 0.015 110)",
      "--card": "oklch(0.2 0.017 110)",
      "--foreground": "oklch(0.958 0.009 110)",
      "--muted-foreground": "oklch(0.716 0.024 110)"
    },
    ":root,\n[data-surface=\"elevation\"]": {
      "--shadow-hairline": "0 0 0 0.5px color-mix(in oklch, var(--foreground) 12%, transparent)",
      "--shadow-raised": "0 1px 2px rgb(0 0 0 / 0.035), 0 3px 8px rgb(0 0 0 / 0.035), 0 8px 28px rgb(0 0 0 / 0.045)",
      "--shadow-overlay": "0 1px 2px rgb(0 0 0 / 0.04), 0 4px 12px rgb(0 0 0 / 0.05), 0 16px 48px rgb(0 0 0 / 0.06)",
      "--inset-highlight": "inset 0 1px 1px rgb(255 255 255 / 0.8)"
    },
    "[data-surface=\"bevel\"]": {
      "--shadow-hairline": "0 0 0 0.5px color-mix(in oklch, var(--foreground) 20%, transparent)",
      "--shadow-raised": "0 0 0 0.5px color-mix(in oklch, var(--foreground) 20%, transparent),\n    0 4px 6px -1px rgb(0 0 0 / 0.05), 0 2px 4px -2px rgb(0 0 0 / 0.05)",
      "--shadow-overlay": "0 0 0 0.5px color-mix(in oklch, var(--foreground) 20%, transparent),\n    0 12px 32px -8px rgb(0 0 0 / 0.12)",
      "--inset-highlight": "inset 0 1px 0 0 rgb(255 255 255 / 0.9), inset 0 -1px 0 0 rgb(0 0 0 / 0.07)"
    },
    "[data-surface=\"glass\"]": {
      "--card": "color-mix(in oklch, var(--background) 62%, transparent)",
      "--popover": "color-mix(in oklch, var(--background) 74%, transparent)",
      "--glass-blur": "20px",
      "--glass-blur-control": "12px",
      "--glass-saturate": "180%",
      "--glass-rim": "rgb(255 255 255 / 0.55)",
      "--glass-rim-control": "rgb(255 255 255 / 0.3)",
      "--glass-rim-soft": "rgb(255 255 255 / 0.14)",
      "--glass-shade": "rgb(0 0 0 / 0.07)",
      "--shadow-hairline": "0 0 0 1px var(--glass-rim-soft)",
      "--shadow-raised": "inset 0 1px 0 0 var(--glass-rim), inset 0 0 0 1px var(--glass-rim-soft),\n    inset 0 -1px 0 0 var(--glass-shade), 0 8px 32px -8px rgb(0 0 0 / 0.18)",
      "--shadow-overlay": "inset 0 1px 0 0 var(--glass-rim), inset 0 0 0 1px var(--glass-rim-soft),\n    inset 0 -1px 0 0 var(--glass-shade), 0 24px 64px -16px rgb(0 0 0 / 0.28)",
      "--inset-highlight": "inset 0 1px 0 0 var(--glass-rim)"
    },
    ".dark[data-surface=\"glass\"],\n.dark [data-surface=\"glass\"]": {
      "--card": "color-mix(in oklch, var(--background) 58%, transparent)",
      "--popover": "color-mix(in oklch, var(--background) 70%, transparent)",
      "--glass-rim": "rgb(255 255 255 / 0.16)",
      "--glass-rim-control": "rgb(255 255 255 / 0.18)",
      "--glass-rim-soft": "rgb(255 255 255 / 0.08)",
      "--glass-shade": "rgb(0 0 0 / 0.3)",
      "--inset-highlight": "inset 0 1px 0 0 var(--glass-rim)"
    },
    "[data-surface=\"glass\"] .surface,\n[data-surface=\"glass\"] [data-slot=\"card\"],\n[data-surface=\"glass\"] [data-slot=\"alert\"],\n[data-surface=\"glass\"] [data-slot=\"popover-content\"],\n[data-surface=\"glass\"] [data-slot=\"dropdown-menu-content\"],\n[data-surface=\"glass\"] [data-slot=\"dialog-content\"],\n[data-surface=\"glass\"] [data-slot=\"alert-dialog-content\"],\n[data-surface=\"glass\"] [data-slot=\"sheet-content\"],\n[data-surface=\"glass\"] [data-slot=\"drawer-content\"],\n[data-surface=\"glass\"] [data-slot=\"select-content\"],\n[data-surface=\"glass\"] [data-slot=\"command\"],\n[data-surface=\"glass\"] [data-slot=\"menubar-content\"],\n[data-surface=\"glass\"] [data-slot=\"context-menu-content\"],\n[data-surface=\"glass\"] [data-slot=\"hover-card-content\"],\n[data-surface=\"glass\"] [data-slot=\"navigation-menu-content\"]": {
      "position": "relative",
      "isolation": "isolate",
      "-webkit-backdrop-filter": "blur(var(--glass-blur)) saturate(var(--glass-saturate))",
      "border-color": "transparent"
    },
    "@supports (backdrop-filter: blur(1px))": {
      "[data-surface=\"glass\"] .surface,\n  [data-surface=\"glass\"] [data-slot=\"card\"],\n  [data-surface=\"glass\"] [data-slot=\"alert\"],\n  [data-surface=\"glass\"] [data-slot=\"popover-content\"],\n  [data-surface=\"glass\"] [data-slot=\"dropdown-menu-content\"],\n  [data-surface=\"glass\"] [data-slot=\"dialog-content\"],\n  [data-surface=\"glass\"] [data-slot=\"alert-dialog-content\"],\n  [data-surface=\"glass\"] [data-slot=\"sheet-content\"],\n  [data-surface=\"glass\"] [data-slot=\"drawer-content\"],\n  [data-surface=\"glass\"] [data-slot=\"select-content\"],\n  [data-surface=\"glass\"] [data-slot=\"command\"],\n  [data-surface=\"glass\"] [data-slot=\"menubar-content\"],\n  [data-surface=\"glass\"] [data-slot=\"context-menu-content\"],\n  [data-surface=\"glass\"] [data-slot=\"hover-card-content\"],\n  [data-surface=\"glass\"] [data-slot=\"navigation-menu-content\"]": {
        "backdrop-filter": "blur(var(--glass-blur)) saturate(var(--glass-saturate))"
      },
      "[data-surface=\"glass\"] [data-slot=\"button\"],\n  [data-surface=\"glass\"] [data-slot=\"toggle\"],\n  [data-surface=\"glass\"] [data-slot=\"toggle-group-item\"]": {
        "backdrop-filter": "blur(var(--glass-blur-control)) saturate(var(--glass-saturate))"
      }
    },
    "[data-surface=\"glass\"] .surface::before,\n[data-surface=\"glass\"] [data-slot=\"card\"]::before,\n[data-surface=\"glass\"] [data-slot=\"popover-content\"]::before,\n[data-surface=\"glass\"] [data-slot=\"dropdown-menu-content\"]::before,\n[data-surface=\"glass\"] [data-slot=\"dialog-content\"]::before,\n[data-surface=\"glass\"] [data-slot=\"sheet-content\"]::before,\n[data-surface=\"glass\"] [data-slot=\"select-content\"]::before": {
      "content": "\"\"",
      "position": "absolute",
      "inset": "0",
      "z-index": "-1",
      "pointer-events": "none",
      "border-radius": "inherit",
      "background": "linear-gradient(\n    135deg,\n    rgb(255 255 255 / 0.22) 0%,\n    rgb(255 255 255 / 0.04) 34%,\n    transparent 58%,\n    rgb(255 255 255 / 0.08) 100%\n  )"
    },
    ".dark [data-surface=\"glass\"] [data-slot=\"card\"]::before,\n.dark[data-surface=\"glass\"] [data-slot=\"card\"]::before,\n.dark [data-surface=\"glass\"] .surface::before,\n.dark[data-surface=\"glass\"] .surface::before": {
      "background": "linear-gradient(\n    135deg,\n    rgb(255 255 255 / 0.09) 0%,\n    transparent 46%,\n    transparent 62%,\n    rgb(255 255 255 / 0.04) 100%\n  )"
    },
    "@supports not (backdrop-filter: blur(1px))": {
      "[data-surface=\"glass\"]": {
        "--card": "var(--background)",
        "--popover": "var(--background)"
      }
    },
    ".glass-ground": {
      "position": "relative",
      "background-image": "radial-gradient(\n      42rem 32rem at 12% 8%,\n      color-mix(in oklch, var(--brand) 18%, transparent),\n      transparent 60%\n    ),\n    radial-gradient(\n      34rem 28rem at 88% 22%,\n      color-mix(in oklch, var(--foreground) 12%, transparent),\n      transparent 62%\n    ),\n    radial-gradient(\n      38rem 30rem at 62% 88%,\n      color-mix(in oklch, var(--brand) 12%, transparent),\n      transparent 58%\n    )",
      "background-attachment": "local"
    },
    ".dark[data-surface=\"elevation\"],\n.dark [data-surface=\"elevation\"]": {
      "--inset-highlight": "inset 0 1px 0 0 rgb(255 255 255 / 0.07)"
    },
    ".dark[data-surface=\"bevel\"],\n.dark [data-surface=\"bevel\"]": {
      "--inset-highlight": "inset 0 1px 0 0 rgb(255 255 255 / 0.11), inset 0 -1px 0 0 rgb(0 0 0 / 0.4)"
    },
    "[data-surface=\"glass\"] [data-slot=\"button\"],\n[data-surface=\"glass\"] [data-slot=\"toggle\"],\n[data-surface=\"glass\"] [data-slot=\"toggle-group-item\"]": {
      "-webkit-backdrop-filter": "blur(var(--glass-blur-control)) saturate(var(--glass-saturate))",
      "box-shadow": "inset 0 1px 0 0 var(--glass-rim-control),\n    inset 0 0 0 1px var(--glass-rim-soft),\n    inset 0 -1px 0 0 var(--glass-shade),\n    0 2px 10px -2px rgb(0 0 0 / 0.14)"
    },
    "[data-surface=\"glass\"] [data-slot=\"button\"][data-variant=\"default\"]": {
      "background": "color-mix(in oklch, var(--primary) 78%, transparent)"
    },
    "[data-surface=\"glass\"] [data-slot=\"button\"][data-variant=\"destructive\"]": {
      "background": "color-mix(in oklch, var(--destructive) 80%, transparent)"
    },
    "[data-surface=\"glass\"] [data-slot=\"button\"][data-variant=\"secondary\"]": {
      "background": "color-mix(in oklch, var(--foreground) 9%, transparent)"
    },
    "[data-surface=\"glass\"] [data-slot=\"button\"][data-variant=\"outline\"]": {
      "background": "color-mix(in oklch, var(--background) 35%, transparent)",
      "border-color": "color-mix(in oklch, var(--foreground) 12%, transparent)"
    },
    "[data-surface=\"glass\"] [data-slot=\"button\"][data-variant=\"ghost\"]": {
      "box-shadow": "none"
    },
    "[data-surface=\"glass\"] [data-slot=\"button\"][data-variant=\"ghost\"]:hover": {
      "background": "color-mix(in oklch, var(--foreground) 7%, transparent)",
      "box-shadow": "inset 0 1px 0 0 var(--glass-rim-control),\n    inset 0 0 0 1px var(--glass-rim-soft)"
    },
    "[data-surface=\"glass\"] [data-slot=\"button\"][data-variant=\"link\"]": {
      "-webkit-backdrop-filter": "none",
      "backdrop-filter": "none",
      "box-shadow": "none"
    },
    "[data-density=\"compact\"]": {
      "--spacing": "0.2rem",
      "--squircle-factor": "1.1",
      "--text-xs--line-height": "1.3",
      "--text-sm--line-height": "1.35",
      "--text-base--line-height": "1.4",
      "--text-lg--line-height": "1.35",
      "--text-xl--line-height": "1.3",
      "--text-2xl--line-height": "1.2"
    },
    "[data-density=\"comfortable\"]": {
      "--spacing": "0.25rem"
    },
    "@layer base": {
      "*": {
        "border-color": "var(--border)",
        "outline-color": "color-mix(in oklch, var(--ring) 50%, transparent)"
      },
      "body": {
        "background-color": "var(--background)",
        "color": "var(--foreground)",
        "font-family": "var(--font-body)",
        "-webkit-font-smoothing": "antialiased"
      },
      "svg.lucide": {
        "stroke-width": "1.5"
      },
      "h1,\n  h2,\n  h3,\n  h4,\n  h5,\n  h6": {
        "font-family": "var(--font-display)"
      },
      "h1,\n  h2,\n  h3": {
        "letter-spacing": "var(--display-tracking)"
      },
      "h4,\n  h5,\n  h6": {
        "letter-spacing": "calc(var(--display-tracking) * 0.66)"
      }
    },
    "@layer components": {
      ".brand-link": {
        "color": "var(--brand-content)",
        "text-decoration": "underline",
        "text-decoration-style": "dotted",
        "text-underline-offset": "3px",
        "text-decoration-color": "color-mix(in oklch, var(--brand) 40%, transparent)"
      },
      ".brand-dot": {
        "background": "var(--brand)",
        "box-shadow": "0 0 0 3px color-mix(in oklch, var(--brand) 15%, transparent)"
      },
      ".brand-glow": {
        "box-shadow": "0 0 36px 2px color-mix(in oklch, var(--brand) 8%, transparent),\n      0 8px 50px 6px color-mix(in oklch, var(--brand) 5%, transparent)"
      },
      ".snake": {
        "position": "relative"
      },
      ".snake::after": {
        "content": "\"\"",
        "position": "absolute",
        "inset": "0",
        "border-radius": "inherit",
        "padding": "1px",
        "background": "conic-gradient(\n      from var(--snake-angle),\n      transparent 0deg,\n      transparent 214deg,\n      color-mix(in oklch, var(--brand) 18%, transparent) 300deg,\n      var(--brand) 350deg,\n      transparent 360deg\n    )",
        "-webkit-mask": "linear-gradient(#000 0 0) content-box,\n      linear-gradient(#000 0 0)",
        "mask": "linear-gradient(#000 0 0) content-box,\n      linear-gradient(#000 0 0)",
        "-webkit-mask-composite": "xor",
        "mask-composite": "exclude",
        "animation": "var(--animate-snake)",
        "pointer-events": "none"
      },
      ".emerge": {
        "animation": "var(--animate-emerge)"
      },
      ".no-scrollbar": {
        "scrollbar-width": "none",
        "-ms-overflow-style": "none"
      },
      ".no-scrollbar::-webkit-scrollbar": {
        "display": "none"
      },
      ".wave-once": {
        "--wave-tone": "var(--success)"
      },
      ".wave-once::before": {
        "content": "\"\"",
        "position": "absolute",
        "top": "0",
        "bottom": "0",
        "left": "-50%",
        "width": "200%",
        "pointer-events": "none",
        "z-index": "1",
        "background": "linear-gradient(\n      100deg,\n      transparent 38%,\n      color-mix(in oklch, var(--wave-tone) 26%, transparent) 50%,\n      transparent 62%\n    )",
        "animation": "swagui-wave 780ms var(--ease-out-expo) both"
      },
      ".shimmer": {
        "background-image": "linear-gradient(\n      100deg,\n      var(--muted-foreground) 34%,\n      color-mix(in oklch, var(--foreground) 78%, var(--brand)) 50%,\n      var(--muted-foreground) 66%\n    )",
        "background-size": "200% auto",
        "background-clip": "text",
        "-webkit-background-clip": "text",
        "color": "transparent",
        "animation": "var(--animate-shimmer)"
      }
    },
    "@media (prefers-reduced-motion: reduce)": {
      ".shimmer": {
        "animation": "none",
        "background-image": "none",
        "color": "var(--muted-foreground)"
      },
      ".snake::after": {
        "animation": "none",
        "background": "color-mix(in oklch, var(--brand) 45%, transparent)"
      },
      ".wave-once::before": {
        "animation": "none",
        "background": "color-mix(in oklch, var(--wave-tone) 12%, transparent)"
      },
      ".emerge": {
        "animation": "none",
        "opacity": "1"
      }
    }
  }
}
